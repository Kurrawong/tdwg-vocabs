PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://example.com/tdwg-vocabs>
    a schema:DataCatalog ;
    skos:historyNote "This catalogue was was created in 2026 to house new TDWG vocabularies" ;
    schema:codeRepository "https://github.com/Kurrawong/tdwg-vocabs" ;
    schema:contributor <https://kurrawong.ai> ;
    schema:creator <https://linked.data.gov.au/org/tdwg> ;
    schema:dateCreated "2026-02-25"^^xsd:date ;
    schema:dateModified "2026-02-25"^^xsd:date ;
    schema:description "Vocabularies created by the international biodiversity information standards group TDWG" ;
    schema:hasPart <http://example.com/GeologicMaterialTypes> ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "TDWG Vocabularies" ;
    schema:publisher <https://linked.data.gov.au/org/tdwg> ;
.
